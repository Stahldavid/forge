{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeos:agent-fabric:control-event:v0.1",
  "title": "Forge Agent Fabric P0a Control Event",
  "type": "object",
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "rootExecutionId": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "number", "minimum": 0 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "payload": {
      "oneOf": [
        { "type": "object", "properties": { "type": { "const": "owner_authorization_registered" }, "authorization": { "$ref": "#/$defs/ownerAuthorization" }, "verification": { "$ref": "#/$defs/ownerAuthorizationVerification" } }, "required": ["type", "authorization", "verification"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "owner_authorization_revoked" }, "authorizationId": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } }, "required": ["type", "authorizationId", "reason"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "resource_ledger_initialized" }, "definitions": { "type": "array", "items": { "$ref": "#/$defs/resourceDefinition" } } }, "required": ["type", "definitions"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "resource_reservation_consumed" }, "reservationId": { "type": "string", "minLength": 1 } }, "required": ["type", "reservationId"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "resource_reservation_released" }, "reservationId": { "type": "string", "minLength": 1 } }, "required": ["type", "reservationId"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "goal_registered" }, "goal": { "$ref": "#/$defs/goal" } }, "required": ["type", "goal"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "grant_registered" }, "grant": { "$ref": "#/$defs/grant" }, "reservation": { "oneOf": [{ "$ref": "#/$defs/resourceReservation" }, { "type": "null" }] } }, "required": ["type", "grant", "reservation"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "grant_revoked" }, "grantId": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } }, "required": ["type", "grantId", "reason"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "plan_delta_registered" }, "delta": { "$ref": "#/$defs/planDelta" } }, "required": ["type", "delta"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "plan_revision_activated" }, "revision": { "$ref": "#/$defs/runPlanRevision" } }, "required": ["type", "revision"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "dispatch_intent_committed" }, "intent": { "$ref": "#/$defs/dispatchIntent" } }, "required": ["type", "intent"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "scheduling_claim_committed" }, "claim": { "$ref": "#/$defs/schedulingClaim" } }, "required": ["type", "claim"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "attempt_execution_permit_issued" }, "permit": { "$ref": "#/$defs/attemptExecutionPermit" } }, "required": ["type", "permit"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "attempt_started" }, "attemptId": { "type": "string", "minLength": 1 }, "permitId": { "type": "string", "minLength": 1 }, "startupReportId": { "type": "string", "minLength": 1 }, "startedAt": { "type": "number", "minimum": 0 } }, "required": ["type", "attemptId", "permitId", "startupReportId", "startedAt"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "attempt_uncertainty_observed" }, "observation": { "$ref": "#/$defs/attemptUncertaintyObservation" } }, "required": ["type", "observation"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "attempt_outcome_committed" }, "outcome": { "$ref": "#/$defs/authoritativeOutcomeCommit" } }, "required": ["type", "outcome"], "additionalProperties": false }
      ]
    },
    "sequence": { "type": "integer", "minimum": 1 },
    "predecessorEventId": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "predecessorEventDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "eventDigest": { "$ref": "#/$defs/digest" }
  },
  "required": ["eventId", "rootExecutionId", "occurredAt", "payload", "sequence", "predecessorEventId", "predecessorEventDigest", "eventDigest"],
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "effectClass": { "type": "string", "enum": ["read", "internal_write", "bounded_external_inference", "consequential"] },
    "resourceDefinition": {
      "type": "object",
      "properties": {
        "resource": { "type": "string", "minLength": 1 },
        "semantics": { "type": "string", "enum": ["consumable", "capacity", "counter"] },
        "limit": { "type": "number", "minimum": 0 }
      },
      "required": ["resource", "semantics", "limit"],
      "additionalProperties": false
    },
    "workflowNode": {
      "type": "object",
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["activity", "verification", "join"] },
        "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "agentSpecId": { "type": "string", "minLength": 1 },
        "harnessSpecId": { "type": "string", "minLength": 1 },
        "executionProfileId": { "type": "string", "minLength": 1 },
        "outputContractId": { "type": "string", "minLength": 1 }
      },
      "required": ["nodeId", "kind", "dependsOn"],
      "additionalProperties": false
    },
    "ownerAuthorization": {
      "type": "object",
      "properties": {
        "authorizationId": { "type": "string", "minLength": 1 },
        "principalId": { "type": "string", "minLength": 1 },
        "rootExecutionId": { "type": "string", "minLength": 1 },
        "goalIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "subjectIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "targetIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "effectClasses": { "type": "array", "items": { "$ref": "#/$defs/effectClass" } },
        "notBefore": { "type": "number", "minimum": 0 },
        "expiresAt": { "type": "number", "minimum": 0 },
        "maximumAttempts": { "type": "integer", "minimum": 1 },
        "maximumDelegationDepth": { "type": "integer", "minimum": 0 },
        "resourceCeilings": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } }
      },
      "required": ["authorizationId", "principalId", "rootExecutionId", "goalIds", "subjectIds", "capabilities", "sourceIds", "targetIds", "effectClasses", "notBefore", "expiresAt", "maximumAttempts", "maximumDelegationDepth", "resourceCeilings"],
      "additionalProperties": false
    },
    "ownerAuthorizationVerification": {
      "type": "object",
      "properties": {
        "verifierId": { "type": "string", "minLength": 1 },
        "authorizationDigest": { "$ref": "#/$defs/digest" },
        "evidenceDigest": { "$ref": "#/$defs/digest" }
      },
      "required": ["verifierId", "authorizationDigest", "evidenceDigest"],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "goalId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "authorityInvocationId": { "type": "string", "minLength": 1 },
        "objectives": { "type": "array", "items": { "type": "string" } },
        "nonObjectives": { "type": "array", "items": { "type": "string" } },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
        "allowedEffectClasses": { "type": "array", "items": { "$ref": "#/$defs/effectClass" } },
        "prohibitedEffectClasses": { "type": "array", "items": { "$ref": "#/$defs/effectClass" } },
        "sourceBoundary": { "type": "object", "properties": { "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "allowExpansion": { "type": "boolean" } }, "required": ["sourceIds", "allowExpansion"], "additionalProperties": false }
      },
      "required": ["goalId", "revision", "authorityInvocationId", "objectives", "nonObjectives", "acceptanceCriteria", "allowedEffectClasses", "prohibitedEffectClasses", "sourceBoundary"],
      "additionalProperties": false
    },
    "grant": {
      "type": "object",
      "properties": {
        "grantId": { "type": "string", "minLength": 1 },
        "rootAuthorizationId": { "type": "string", "minLength": 1 },
        "subjectId": { "type": "string", "minLength": 1 },
        "parentGrantId": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "targetIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "effectClasses": { "type": "array", "items": { "$ref": "#/$defs/effectClass" } },
        "notBefore": { "type": "number", "minimum": 0 },
        "expiresAt": { "type": "number", "minimum": 0 },
        "maximumAttempts": { "type": "integer", "minimum": 1 },
        "delegationDepthRemaining": { "type": "integer", "minimum": 0 },
        "resourceCeilings": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } },
        "reservationId": { "type": "string", "minLength": 1 }
      },
      "required": ["grantId", "rootAuthorizationId", "subjectId", "parentGrantId", "capabilities", "sourceIds", "targetIds", "effectClasses", "notBefore", "expiresAt", "maximumAttempts", "delegationDepthRemaining", "resourceCeilings"],
      "additionalProperties": false
    },
    "resourceReservation": {
      "type": "object",
      "properties": {
        "reservationId": { "type": "string", "minLength": 1 },
        "ownerId": { "type": "string", "minLength": 1 },
        "requests": { "type": "array", "items": { "type": "object", "properties": { "resource": { "type": "string", "minLength": 1 }, "amount": { "type": "number", "exclusiveMinimum": 0 } }, "required": ["resource", "amount"], "additionalProperties": false } },
        "status": { "type": "string", "enum": ["active", "consumed", "released"] }
      },
      "required": ["reservationId", "ownerId", "requests", "status"],
      "additionalProperties": false
    },
    "planDeltaOperation": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "add_node" }, "node": { "$ref": "#/$defs/workflowNode" } }, "required": ["kind", "node"], "additionalProperties": false },
        { "type": "object", "properties": { "kind": { "const": "replace_node" }, "node": { "$ref": "#/$defs/workflowNode" } }, "required": ["kind", "node"], "additionalProperties": false },
        { "type": "object", "properties": { "kind": { "const": "remove_node" }, "nodeId": { "type": "string", "minLength": 1 } }, "required": ["kind", "nodeId"], "additionalProperties": false }
      ]
    },
    "planDelta": {
      "type": "object",
      "properties": {
        "deltaId": { "type": "string", "minLength": 1 },
        "rootExecutionId": { "type": "string", "minLength": 1 },
        "baseRevisionId": { "type": "string", "minLength": 1 },
        "nextRevisionId": { "type": "string", "minLength": 1 },
        "operations": { "type": "array", "items": { "$ref": "#/$defs/planDeltaOperation" } }
      },
      "required": ["deltaId", "rootExecutionId", "baseRevisionId", "nextRevisionId", "operations"],
      "additionalProperties": false
    },
    "runPlanRevision": {
      "type": "object",
      "properties": {
        "revisionId": { "type": "string", "minLength": 1 },
        "rootExecutionId": { "type": "string", "minLength": 1 },
        "goalId": { "type": "string", "minLength": 1 },
        "programVersionId": { "type": "string", "minLength": 1 },
        "revisionNumber": { "type": "integer", "minimum": 1 },
        "parentRevisionId": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "sourcePlanDeltaId": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/workflowNode" } },
        "contentDigest": { "$ref": "#/$defs/digest" }
      },
      "required": ["revisionId", "rootExecutionId", "goalId", "programVersionId", "revisionNumber", "parentRevisionId", "sourcePlanDeltaId", "nodes", "contentDigest"],
      "additionalProperties": false
    },
    "dispatchIntent": {
      "type": "object",
      "properties": {
        "intentId": { "type": "string", "minLength": 1 },
        "rootExecutionId": { "type": "string", "minLength": 1 },
        "planRevisionId": { "type": "string", "minLength": 1 },
        "taskNodeId": { "type": "string", "minLength": 1 },
        "effectiveRunSpecDigest": { "$ref": "#/$defs/digest" },
        "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "targetId": { "type": "string", "minLength": 1 },
        "requiredCapability": { "type": "string", "minLength": 1 },
        "effectClass": { "$ref": "#/$defs/effectClass" },
        "createdAt": { "type": "number", "minimum": 0 }
      },
      "required": ["intentId", "rootExecutionId", "planRevisionId", "taskNodeId", "effectiveRunSpecDigest", "sourceIds", "targetId", "requiredCapability", "effectClass", "createdAt"],
      "additionalProperties": false
    },
    "schedulingClaim": {
      "type": "object",
      "properties": {
        "claimId": { "type": "string", "minLength": 1 },
        "intentId": { "type": "string", "minLength": 1 },
        "workerId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "minLength": 1 },
        "leaseExpiresAt": { "type": "number", "minimum": 0 },
        "fencingToken": { "type": "integer", "minimum": 1 },
        "committedAt": { "type": "number", "minimum": 0 }
      },
      "required": ["claimId", "intentId", "workerId", "attemptId", "leaseExpiresAt", "fencingToken", "committedAt"],
      "additionalProperties": false
    },
    "attemptExecutionPermit": {
      "type": "object",
      "properties": {
        "permitId": { "type": "string", "minLength": 1 },
        "intentId": { "type": "string", "minLength": 1 },
        "claimId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "minLength": 1 },
        "workerId": { "type": "string", "minLength": 1 },
        "planRevisionId": { "type": "string", "minLength": 1 },
        "effectiveRunSpecDigest": { "$ref": "#/$defs/digest" },
        "grantId": { "type": "string", "minLength": 1 },
        "fencingToken": { "type": "integer", "minimum": 1 },
        "notBefore": { "type": "number", "minimum": 0 },
        "expiresAt": { "type": "number", "minimum": 0 }
      },
      "required": ["permitId", "intentId", "claimId", "attemptId", "workerId", "planRevisionId", "effectiveRunSpecDigest", "grantId", "fencingToken", "notBefore", "expiresAt"],
      "additionalProperties": false
    },
    "attemptUncertaintyObservation": {
      "type": "object",
      "properties": {
        "observationId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "minLength": 1 },
        "permitId": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "enum": ["startup", "outcome"] },
        "reason": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "number", "minimum": 0 }
      },
      "required": ["observationId", "attemptId", "permitId", "phase", "reason", "observedAt"],
      "additionalProperties": false
    },
    "workerResultReport": {
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "minLength": 1 },
        "permitId": { "type": "string", "minLength": 1 },
        "intentId": { "type": "string", "minLength": 1 },
        "planRevisionId": { "type": "string", "minLength": 1 },
        "effectiveRunSpecDigest": { "$ref": "#/$defs/digest" },
        "fencingToken": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["succeeded", "failed"] },
        "resultDigest": { "$ref": "#/$defs/digest" },
        "evidenceDigests": { "type": "array", "items": { "$ref": "#/$defs/digest" } },
        "reportedAt": { "type": "number", "minimum": 0 }
      },
      "required": ["reportId", "attemptId", "permitId", "intentId", "planRevisionId", "effectiveRunSpecDigest", "fencingToken", "status", "resultDigest", "evidenceDigests", "reportedAt"],
      "additionalProperties": false
    },
    "authoritativeOutcomeCommit": {
      "type": "object",
      "properties": {
        "outcomeId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "minLength": 1 },
        "permitId": { "type": "string", "minLength": 1 },
        "intentId": { "type": "string", "minLength": 1 },
        "planRevisionId": { "type": "string", "minLength": 1 },
        "effectiveRunSpecDigest": { "$ref": "#/$defs/digest" },
        "fencingToken": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["succeeded", "failed"] },
        "resultDigest": { "$ref": "#/$defs/digest" },
        "reportId": { "type": "string", "minLength": 1 },
        "reportDigest": { "$ref": "#/$defs/digest" },
        "evidenceDigests": { "type": "array", "items": { "$ref": "#/$defs/digest" } },
        "reportedAt": { "type": "number", "minimum": 0 },
        "committedAt": { "type": "number", "minimum": 0 }
      },
      "required": ["outcomeId", "attemptId", "permitId", "intentId", "planRevisionId", "effectiveRunSpecDigest", "fencingToken", "status", "resultDigest", "reportId", "reportDigest", "evidenceDigests", "reportedAt", "committedAt"],
      "additionalProperties": false
    }
  }
}
